# Kopirajte u .env.local i popunite. .env.local se NIKAD ne commita.

# --- Baza -------------------------------------------------------------------
# Na OctaDeployu se DATABASE_URL ubacuje automatski - ne postavljati rucno.
DATABASE_URL=postgres://postgres:lozinka@localhost:5432/marketplace

# Alternativa za lokalni rad, ako ne zelite pun URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=marketplace
# DB_USER=postgres
# DB_PASSWORD=

# --- Sesije CMS-a -----------------------------------------------------------
# Obavezno, minimalno 32 znaka. Generisati sa:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# --- Prevod opisa na bosanski (Claude API) ----------------------------------
# Bez ovog kljuca uvoz radi normalno, samo se opisi ne prevode automatski.
ANTHROPIC_API_KEY=

# --- Ostalo -----------------------------------------------------------------
# Puna adresa sajta, koristi se za apsolutne URL-ove u meta tagovima.
SITE_URL=https://marketplace-ba.octadeploy.com

# Prvi admin nalog (koristi samo scripts/seed.js, jednom)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
